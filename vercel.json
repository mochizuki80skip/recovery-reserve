{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)\\.(html|js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/admin/customers.js": { "maxDuration": 300 },
    "api/admin/monthly.js": { "maxDuration": 120 },
    "api/cron-churn.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron-churn?clinic=192", "schedule": "0 0 * * *" },
    { "path": "/api/cron-churn?clinic=193", "schedule": "10 0 * * *" }
  ]
}
